generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ORGANIZER
  GATE_MANAGER
  GATE_STAFF
  CUSTOMER
}

model User {
  id       String   @id @default(uuid())
  name     String
  email    String   @unique
  password String
  role     UserRole @default(CUSTOMER)

  payments Payment[]

  events Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets Ticket[]

  orders Order[]

  checkIns CheckIn[]

  gateAssignments GateStaff[]

  entryRequestsAsCustomer EntryRequest[] @relation("EntryRequestCustomer")
  entryRequestsResolved   EntryRequest[] @relation("EntryRequestResolver")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

model Event {
  id          String      @id @default(uuid())
  name        String
  description String?
  location    String
  startsAt    DateTime
  endsAt      DateTime?
  status      EventStatus @default(DRAFT)

  organizerId String
  organizer   User   @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticketTypes TicketType[]

  gates Gate[]

  @@index([organizerId])
  @@index([status])
}

model TicketType {
  id          String  @id @default(uuid())
  name        String
  description String?
  price       Decimal @db.Decimal(12, 2)
  quantity    Int

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tickets   Ticket[]

  payments Payment[]

  @@index([eventId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum TicketStatus {
  VALID
  USED
  CANCELLED
}

model Order {
  id     String      @id @default(uuid())
  status OrderStatus @default(PENDING)
  total  Decimal     @db.Decimal(12, 2)

  customerId String
  customer   User   @relation(fields: [customerId], references: [id])

  tickets Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment Payment?

  @@index([customerId])
}

model Ticket {
  id     String       @id @default(uuid())
  code   String       @unique
  status TicketStatus @default(VALID)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  ticketTypeId String
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])

  customerId String
  customer   User   @relation(fields: [customerId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  checkIns  CheckIn[]

  entryRequests EntryRequest[]

  @@index([orderId])
  @@index([ticketTypeId])
  @@index([customerId])
}

model CheckIn {
  id String @id @default(uuid())

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id])

  validatedById String
  validatedBy   User   @relation(fields: [validatedById], references: [id])

  gateId String?
  gate   Gate?   @relation(fields: [gateId], references: [id])

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([validatedById])
  @@index([gateId])
}

model Gate {
  id   String @id @default(uuid())
  name String

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  staff    GateStaff[]
  checkIns CheckIn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entryRequests EntryRequest[]

  @@index([eventId])
}

model GateStaff {
  id String @id @default(uuid())

  gateId String
  gate   Gate   @relation(fields: [gateId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([gateId, userId])
  @@index([userId])
}

enum PaymentStatus {
  PAID
  FAILED
}

enum PaymentMethod {
  MPESA
  EMOLA
  MKESH
  CARD
}

enum PaymentProvider {
  SIMULATED
}

model Payment {
  id            String          @id @default(uuid())
  amount        Decimal         @db.Decimal(12, 2)
  currency      String          @default("MZN")
  method        PaymentMethod
  provider      PaymentProvider @default(SIMULATED)
  status        PaymentStatus
  reference     String          @unique
  phone         String?
  failureReason String?
  paidAt        DateTime?

  customerId String
  customer   User   @relation(fields: [customerId], references: [id])

  ticketTypeId String
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])

  orderId String? @unique
  order   Order?  @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([ticketTypeId])
}

enum EntryRequestStatus {
  PENDING
  CONFIRMED
  REJECTED
}

model EntryRequest {
  id String @id @default(uuid())

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id])

  gateId String
  gate   Gate   @relation(fields: [gateId], references: [id])

  customerId String
  customer   User   @relation("EntryRequestCustomer", fields: [customerId], references: [id])

  status EntryRequestStatus @default(PENDING)

  resolvedById String?
  resolvedBy   User?   @relation("EntryRequestResolver", fields: [resolvedById], references: [id])

  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId, status])
  @@index([gateId, status])
  @@index([customerId])
  @@index([resolvedById])
}
